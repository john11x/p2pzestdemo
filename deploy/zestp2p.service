[Unit]
Description=ZestP2P Spring Boot application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/zestp2p
EnvironmentFile=/etc/zestp2p/zestp2p.env
ExecStart=/usr/bin/java -jar /opt/zestp2p/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target